DATABASE_URL=
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
WEB_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
NODE_ENV=development
PORT=3001

# Super Admin (wajib password kuat di production; bukan ChangeMeAdmin12)
SUPER_ADMIN_EMAIL=admin@kranjang.local
SUPER_ADMIN_PASSWORD=ChangeMeAdmin12

# Billing / Midtrans (kosong = checkout tanpa snapToken; mock-pay hanya non-prod)
# ALLOW_MOCK_PAY diabaikan di production — mock-pay selalu ditolak
ALLOW_MOCK_PAY=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email (opsional)
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_OVERRIDE=

# Observability (opsional)
SENTRY_DSN=
